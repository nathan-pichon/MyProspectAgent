# MyProspectAgent — local secrets (optional)
#
# API keys are read LOCALLY only. They are NEVER stored in prospect.config.json
# and NEVER entered on the static web configurator. Use env vars (copy this to
# your shell profile) OR the dashboard ⚙ panel (writes .prospect_secrets.json,
# chmod 600), whichever you prefer.

# Main LLM provider key (only needed if llm.provider is a cloud provider).
PROSPECT_LLM_API_KEY=

# Optional "strong" tier key — used for the Qualifier + Outreacher when you
# configure llm.strong_provider / llm.strong_model (e.g. Anthropic Claude).
PROSPECT_STRONG_LLM_API_KEY=
